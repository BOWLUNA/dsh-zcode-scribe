# Same intent as the reference repository, so an editor behaves identically in
# both: LF everywhere and a final newline, which keeps diffs honest.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false
